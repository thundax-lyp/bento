{
    "name": "@bento/workspace-web",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format:check": "prettier --check . --ignore-path ../../../.prettierignore",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "test:space-integrity": "playwright test --config playwright.web-space-integrity.config.ts",
        "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
        "test:queue-isolation": "playwright test --config playwright.web-queue-isolation.config.ts",
        "test:api-fixtures": "node --import ../../../register-paths.mjs --test acceptance/fixtures/workspace-api/tests/*.test.ts"
    },
    "dependencies": {
        "@radix-ui/react-slot": "^1.2.4",
        "@tanstack/react-query": "^5.90.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-router": "^7.9.0"
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "3.1164.0",
        "@aws-sdk/s3-request-presigner": "3.1164.0",
        "@playwright/test": "^1.56.0",
        "@tailwindcss/vite": "^4.1.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.0",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.0.0",
        "eslint-plugin-react-hooks": "^7.0.0",
        "globals": "^17.0.0",
        "jsdom": "^27.0.0",
        "openid-client": "6.8.9",
        "tailwindcss": "^4.1.0",
        "vite": "^8.0.0",
        "vitest": "^4.1.0"
    }
}
