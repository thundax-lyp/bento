{
    "name": "@bento/orchestrator",
    "private": true,
    "type": "module",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "node --import ../../register-paths.mjs --experimental-strip-types --test execution-service/service.test.ts execution-service/task-submission.test.ts openshell/*.test.ts",
        "check": "pnpm check:core && pnpm test:temporal-retry && node acceptance/temporal-retry/check-package.mjs",
        "check:core": "pnpm typecheck && pnpm test && go test ./... && go vet ./...",
        "test:temporal-retry": "node --import ../../register-paths.mjs --experimental-strip-types --test --test-concurrency=1 --test-timeout=1200000 acceptance/temporal-retry/real-retry.test.ts"
    },
    "dependencies": {
        "@bento/worker": "workspace:*",
        "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.4"
    },
    "devDependencies": {
        "@deepseek-ai/cordis": "4.0.5",
        "@deepseek-ai/dsh-agent": "0.2.1-rc.4",
        "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.4",
        "@deepseek-ai/dsh-llm": "0.2.1-rc.4",
        "@deepseek-ai/dsh-scope": "0.2.1-rc.4",
        "@deepseek-ai/dsh-session": "0.2.1-rc.4",
        "@deepseek-ai/dsh-session-checkpoint-policy": "0.2.1-rc.4",
        "@deepseek-ai/dsh-session-projection": "0.2.1-rc.4",
        "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.4",
        "@deepseek-ai/dsh-tools": "0.2.1-rc.4"
    }
}
