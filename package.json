{
    "name": "bento",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.15.0",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "check": "pnpm check:workspace && pnpm check:orchestrator && pnpm check:worker && pnpm lint && pnpm format:check",
        "check:workspace": "pnpm --filter @bento/workspace-auth build && pnpm --filter @bento/workspace-api check && pnpm --filter @bento/web check",
        "check:orchestrator": "pnpm --filter @bento/orchestrator check",
        "check:worker": "pnpm --filter @bento/worker typecheck",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.20.5",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.10",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1"
    },
    "files": [
        "shared/text-snapshot.ts",
        "apps/orchestrator",
        "apps/workspace/api",
        "apps/workspace/auth",
        "!apps/workspace/auth/dist",
        "apps/worker",
        "docs/00-governance/ARCHITECTURE.md",
        "assets/architecture.svg",
        "docs/10-requirements/APPLICATION-BOUNDARIES-REQUIREMENTS.md",
        "docs/10-requirements/WEB-REQUIREMENTS.md",
        "docs/20-interfaces/WEB-INTERFACE.md",
        "docs/30-designs/APPLICATION-BOUNDARIES-DESIGN.md",
        "docs/30-designs/WEB-DESIGN.md",
        "docs/40-readiness/CURRENT-READINESS.md",
        "deploy/README.md",
        "public-files.json"
    ]
}
