{
    "name": "bento",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.15.0",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "typecheck": "pnpm --filter @bento/workspace-api --filter @bento/orchestrator --filter @bento/worker run typecheck",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "pnpm check:go && pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:execution && pnpm --filter @bento/web check",
        "check:execution": "pnpm --filter @bento/orchestrator test",
        "check:go": "(cd apps/orchestrator && go test ./... && go vet ./...) && (cd apps/workspace/api/go && go test ./... && go vet ./...)"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.20.5",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.10",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1"
    },
    "files": [
        "apps/orchestrator",
        "apps/workspace/api",
        "apps/workspace/auth",
        "apps/worker",
        "docs/00-governance/ARCHITECTURE.md",
        "docs/00-governance/architecture.svg",
        "docs/10-requirements/APPLICATION-BOUNDARIES-REQUIREMENTS.md",
        "docs/10-requirements/WEB-REQUIREMENTS.md",
        "docs/20-interfaces/WEB-INTERFACE.md",
        "docs/30-designs/APPLICATION-BOUNDARIES-DESIGN.md",
        "docs/30-designs/WEB-DESIGN.md",
        "docs/40-readiness/README.md",
        "deploy/README.md",
        "public-files.json"
    ]
}
