{
    "name": "bento",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.15.0",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "pnpm check:go && pnpm check:publication && pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:execution && pnpm --filter @bento/web check",
        "check:execution": "node --experimental-strip-types --test src/execution-service/service.test.ts",
        "check:publication": "python3 scripts/check-publication.py",
        "check:go": "(cd apps/orchestrator && go test ./... && go vet ./...) && (cd apps/workspace/api/go && go test ./... && go vet ./...)"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.20.5",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.10",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.1164.0",
        "@aws-sdk/s3-request-presigner": "3.1164.0",
        "@deepseek-ai/cordis": "4.0.5",
        "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.4",
        "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.4",
        "dsh-sandbox-openshell": "0.1.0-rc.1",
        "openid-client": "6.8.9"
    },
    "files": [
        "src",
        "apps/orchestrator",
        "apps/workspace/api",
        "apps/workspace/auth",
        "apps/worker",
        "docs/research/README.md",
        "docs/research/architecture.md",
        "docs/research/capabilities.md",
        "docs/research/implementation.md",
        "docs/deployments/openshell-dsh.md",
        "docs/PUBLISHING.md",
        "scripts/check-publication.py",
        "public-files.json"
    ]
}
