{
    "name": "bento",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.15.0",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "pnpm check:publication && pnpm typecheck && pnpm lint && pnpm format:check",
        "check:publication": "python3 scripts/check-publication.py"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.20.5",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.10",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1"
    },
    "dependencies": {
        "dsh-sandbox-openshell": "0.1.0-rc.1"
    },
    "files": [
        "src",
        "docs/research/README.md",
        "docs/research/architecture.md",
        "docs/research/capabilities.md",
        "docs/research/implementation.md",
        "docs/deployments/openshell-dsh.md",
        "docs/PUBLISHING.md",
        "scripts/check-publication.py",
        "public-files.json"
    ]
}
