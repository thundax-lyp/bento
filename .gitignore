# Public repository roots are opt-in. Update public-files.json alongside this list.
/*
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/checks.yml
!/.dockerignore
!/Dockerfile
!/compose.yaml
!/deploy/
/deploy/*
!/deploy/web/
/deploy/web/*
!/deploy/web/nginx.conf
!/deploy/web/start.sh
!/.editorconfig
!/.gitignore
!/.prettierignore
!/.prettierrc.json
!/README.md
!/.agents/
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/bento-codex-comment-fix/
/.agents/skills/bento-codex-comment-fix/**
!/.agents/skills/bento-pr-review/
/.agents/skills/bento-pr-review/**
!/.agents/skills/bento-codex-comment-fix/SKILL.md
!/.agents/skills/bento-codex-comment-fix/agents/
!/.agents/skills/bento-codex-comment-fix/agents/openai.yaml
!/.agents/skills/bento-pr-review/SKILL.md
!/.agents/skills/bento-pr-review/agents/
!/.agents/skills/bento-pr-review/agents/openai.yaml
!/.agents/skills/bento-pr-review/references/
!/.agents/skills/bento-pr-review/references/coverage-and-output.md
!/.agents/skills/bento-pr-review/references/evidence-matrix.md
!/.agents/skills/bento-pr-review/references/review-checks.md
!/.agents/skills/bento-pr-review/references/review-dimensions.md
!/.agents/skills/bento-pr-review/scripts/
!/.agents/skills/bento-pr-review/scripts/collect-review-context.mjs
!/eslint.config.mjs
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/tsconfig.json
!/public-files.json
!/src/
!/apps/
/apps/*
!/apps/web/
!/docs/
!/scripts/

# Only reviewed public documents and tooling are eligible.
/docs/*
!/docs/PUBLISHING.md
!/docs/00-governance/
/docs/00-governance/*
!/docs/00-governance/*-RULES.md
!/docs/10-requirements/
/docs/10-requirements/*
!/docs/10-requirements/README.md
!/docs/30-designs/
/docs/30-designs/*
!/docs/30-designs/README.md
!/docs/40-readiness/
/docs/40-readiness/*
!/docs/40-readiness/README.md
!/docs/40-readiness/MVP-PREFLIGHT-EVIDENCE.md
!/docs/40-readiness/TEMPORAL-DEV-EVIDENCE.md
!/docs/research/
!/docs/deployments/
/docs/research/*
!/docs/research/README.md
!/docs/research/architecture.md
!/docs/research/capabilities.md
!/docs/research/implementation.md
/docs/deployments/*
!/docs/deployments/openshell-dsh.md
!/docs/deployments/HOW-TO-WEB-DOCKER.md
!/docs/deployments/HOW-TO-TEMPORAL-DEV.md
/scripts/*
!/scripts/check-publication.py

# Private evidence and deployment material stay local, byte-identical.
/validation/
/docs/research/archive/
/docs/ARCHITECTURE.md
/docs/DSH-OPENSHELL-V0.1.md

# Secrets, IDE state and generated runtime material are never public inputs.
**/.idea/
**/node_modules/
**/runtime/
**/cache/
**/.cache/
**/_logs/
**/.npmrc
**/.env
**/.env.*
!**/.env.example
**/DRAFT.md
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/id_rsa
**/id_ed25519
**/*.sqlite
**/*.sqlite-*
**/.DS_Store
/dist/
/coverage/
