# Public repository roots are opt-in. Update public-files.json alongside this list.
/*
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/checks.yml
!/.dockerignore
!/deploy/
/deploy/*
!/deploy/compose.yaml
!/deploy/compose.keycloak.yaml
!/deploy/README.md
!/deploy/worker/
/deploy/worker/*
!/deploy/worker/Dockerfile
!/deploy/worker/Dockerfile.dockerignore
!/deploy/workspace/
/deploy/workspace/*
!/deploy/workspace/nginx.conf
!/deploy/workspace/start.sh
!/deploy/keycloak/
/deploy/keycloak/*
!/deploy/keycloak/compose.yaml
!/deploy/keycloak/theme/
/deploy/keycloak/theme/*
!/deploy/keycloak/theme/login/
/deploy/keycloak/theme/login/*
!/deploy/keycloak/theme/login/theme.properties
!/deploy/keycloak/theme/login/messages/
/deploy/keycloak/theme/login/messages/*
!/deploy/keycloak/theme/login/messages/messages_en.properties
!/deploy/keycloak/theme/login/resources/
/deploy/keycloak/theme/login/resources/*
!/deploy/keycloak/theme/login/resources/css/
/deploy/keycloak/theme/login/resources/css/*
!/deploy/keycloak/theme/login/resources/css/bento.css
!/.editorconfig
!/.gitignore
!/.prettierignore
!/.prettierrc.json
!/README.md
!/AGENTS.md
!/.agents/
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/bento-codex-comment-fix/
/.agents/skills/bento-codex-comment-fix/**
!/.agents/skills/bento-pr-review/
/.agents/skills/bento-pr-review/**
