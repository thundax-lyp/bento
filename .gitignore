!/.agents/skills/bento-pr-review/scripts/collect-review-context.mjs
!/eslint.config.mjs
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/tsconfig.json
!/public-files.json
!/apps/
/apps/*
!/apps/workspace/
!/apps/workspace/web/
!/apps/workspace/auth/
!/apps/workspace/api/
!/apps/worker/
!/apps/orchestrator/
/apps/orchestrator/*
!/apps/orchestrator/*.go
!/apps/orchestrator/index.ts
!/apps/orchestrator/execution-service/
/apps/orchestrator/execution-service/*
!/apps/orchestrator/execution-service/*.ts
!/apps/orchestrator/openshell/
/apps/orchestrator/openshell/*
!/apps/orchestrator/openshell/*.ts
!/apps/orchestrator/go.mod
!/apps/orchestrator/go.sum
!/docs/

# Only reviewed public documents and tooling are eligible.
/docs/*
!/docs/00-governance/
/docs/00-governance/*
!/docs/00-governance/*-RULES.md
!/docs/10-requirements/
/docs/10-requirements/*
!/docs/10-requirements/README.md
!/docs/10-requirements/APPLICATION-BOUNDARIES-REQUIREMENTS.md
!/docs/10-requirements/WEB-AUTH-REQUIREMENTS.md
!/docs/30-designs/
/docs/30-designs/*
!/docs/30-designs/README.md
!/docs/30-designs/PLATFORM-ARCHITECTURE-DESIGN.md
!/docs/30-designs/DSH-OPENSHELL-IMPLEMENTATION-DESIGN.md
!/docs/30-designs/WORKSPACE-AUTH-AND-ACCOUNTS-DESIGN.md
!/docs/30-designs/ENGINEERING-STRUCTURE-DESIGN.md
!/docs/40-readiness/
/docs/40-readiness/*
!/docs/40-readiness/README.md
!/docs/40-readiness/DSH-OPENSHELL-EVIDENCE.md
!/docs/40-readiness/DSH-OPENSHELL-ACCEPTANCE.md
