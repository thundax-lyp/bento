!/.agents/skills/bento-codex-comment-fix/agents/
!/.agents/skills/bento-codex-comment-fix/agents/openai.yaml
!/.agents/skills/bento-pr-review/SKILL.md
!/.agents/skills/bento-pr-review/agents/
!/.agents/skills/bento-pr-review/agents/openai.yaml
!/.agents/skills/bento-pr-review/references/
!/.agents/skills/bento-pr-review/references/coverage-and-output.md
